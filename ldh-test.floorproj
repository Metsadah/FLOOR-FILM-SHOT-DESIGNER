:false,"text":"KLEURCODES LEGER DES HEILS"},{"id":"nhonet9n2p","cat":"colorcard","kind":"colorcard","x":-805,"y":1065,"rot":0,"w":150,"h":120,"color":"#E7231A","label":"Rood (web)","path":[],"hex":"#E7231A"},{"id":"dfskgpzn2p","cat":"colorcard","kind":"colorcard","x":-625,"y":1065,"rot":0,"w":150,"h":120,"color":"#CB1E15","label":"Rood donker","path":[],"hex":"#CB1E15"},{"id":"xpj6o91n2p","cat":"colorcard","kind":"colorcard","x":-445,"y":1065,"rot":0,"w":150,"h":120,"color":"#EF3E42","label":"Schild P185","path":[],"hex":"#EF3E42"},{"id":"19o5pbin2p","cat":"colorcard","kind":"colorcard","x":-265,"y":1065,"rot":0,"w":150,"h":120,"color":"#072329","label":"Petrol","path":[],"hex":"#072329"},{"id":"7cwql93n2p","cat":"colorcard","kind":"colorcard","x":-85,"y":1065,"rot":0,"w":150,"h":120,"color":"#65777A","label":"Grijsgroen","path":[],"hex":"#65777A"},{"id":"qifnmjbn2p","cat":"colorcard","kind":"colorcard","x":95,"y":1065,"rot":0,"w":150,"h":120,"color":"#C8D9D4","label":"Mint","path":[],"hex":"#C8D9D4"},{"id":"opprr4un2p","cat":"colorcard","kind":"colorcard","x":275,"y":1065,"rot":0,"w":150,"h":120,"color":"#E1D8CF","label":"Zand","path":[],"hex":"#E1D8CF"},{"id":"uxohgdbn2p","cat":"colorcard","kind":"colorcard","x":455,"y":1065,"rot":0,"w":150,"h":120,"color":"#F6F3EF","label":"Papier","path":[],"hex":"#F6F3EF"},{"id":"1on859xn2p","cat":"note","kind":"note","x":715,"y":1065,"rot":0,"w":300,"h":120,"color":"#E1B46A","label":"","path":[],"text":"BRON\nRood #E7231A, donker petrol #072329, grijsgroen, mint, zand en papier komen uit de stylesheet van legerdesheils.nl (sept 2026). Schildrood = internationale richtlijn Pantone 185 C (#EF3E42). Check tegen het huisstijlhandboek \"Vriendelijk doch beslist\"."},{"id":"joy7yqsn2q","cat":"text","kind":"text","x":-590,"y":1200,"rot":0,"w":580,"h":25.6,"color":"#B8332A","label":"","path":[],"fontSize":16,"bold":true,"italic":false,"text":"ZWART-WIT MET ROOD"},{"id":"y2a0ksqn2q","cat":"line","kind":"line","x":-730,"y":1388,"rot":0,"w":55.71355310873648,"h":14,"color":"#E7231A","label":"","path":[],"p1":{"x":-720,"y":1362},"p2":{"x":-740,"y":1414},"weight":2.5,"dashed":false,"arrow":true},{"id":"hxtwtwhn2q","cat":"text","kind":"text","x":-590,"y":2176,"rot":0,"w":580,"h":25.6,"color":"#B8332A","label":"","path":[],"fontSize":16,"bold":true,"italic":false,"text":"STUDIO: ALLES IS NEP"},{"id":"zw34635n2q","cat":"line","kind":"line","x":-730,"y":2364,"rot":0,"w":55.71355310873648,"h":14,"color":"#E7231A","label":"","path":[],"p1":{"x":-720,"y":2338},"p2":{"x":-740,"y":2390},"weight":2.5,"dashed":false,"arrow":true},{"id":"0mfsi3tn2q","cat":"text","kind":"text","x":70,"y":1200,"rot":0,"w":580,"h":25.6,"color":"#B8332A","label":"","path":[],"fontSize":16,"bold":true,"italic":false,"text":"ECHT EN RAUW, ZACHT GENOEG VOOR KERST"},{"id":"bs16r3ln2q","cat":"line","kind":"line","x":-70,"y":1388,"rot":0,"w":55.71355310873648,"h":14,"color":"#E7231A","label":"","path":[],"p1":{"x":-60,"y":1362},"p2":{"x":-80,"y":1414},"weight":2.5,"dashed":false,"arrow":true},{"id":"rjsa1btn2q","cat":"text","kind":"text","x":730,"y":1200,"rot":0,"w":580,"h":25.6,"color":"#B8332A","label":"","path":[],"fontSize":16,"bold":true,"italic":false,"text":"BESTAANDE FILM: RUWE EMOTIE"},{"id":"vazs0qfn2q","cat":"line","kind":"line","x":590,"y":1388,"rot":0,"w":55.71355310873648,"h":14,"color":"#E7231A","label":"","path":[],"p1":{"x":600,"y":1362},"p2":{"x":580,"y":1414},"weight":2.5,"dashed":false,"arrow":true},{"id":"shzvaohn2q","cat":"text","kind":"text","x":1390,"y":1200,"rot":0,"w":580,"h":25.6,"color":"#B8332A","label":"","path":[],"fontSize":16,"bold":true,"italic":false,"text":"KERSTSTAL (OPTIE 3B)"},{"id":"hbrkgnwn2q","cat":"colcard","kind":"colcard","x":1260,"y":1299,"rot":0,"w":320,"h":110,"color":"#B8332A","label":"","path":[],"cw":320,"title":"Kerststal (optie 3B)","text":"Referenties voor optie 3B: de stal als lichtbron in het donker, de kribbe als beeld van \"er is plaats\"."},{"id":"ia480yen2q","cat":"line","kind":"line","x":1250,"y":1388,"rot":0,"w":55.71355310873648,"h":14,"color":"#E7231A","label":"","path":[],"p1":{"x":1260,"y":1362},"p2":{"x":1240,"y":1414},"weight":2.5,"dashed":false,"arrow":true}],"stills":[],"scene":"","sceneDesc":"","script":"","date":"","time":"","duration":60,"weather":"Any","sun":null,"shots":[]},"scriptboard":{"id":"oge3calbjf","name":"Script & storyboard","walls":[],"objects":[{"id":"9p1tvbpbjf","cat":"text","kind":"text","x":-1150,"y":-1000,"rot":0,"w":389.76,"h":44.8,"color":"#2B2A27","label":"","path":[],"fontSize":32,"bold":true,"italic":false,"text":"Kerst is… — de opties"},{"id":"clxjnvfbjf","cat":"text","kind":"text","x":-1150,"y":-955,"rot":0,"w":1331.6799999999998,"h":19.599999999999998,"color":"#6B675F","label":"","path":[],"fontSize":14,"bold":false,"italic":false,"text":"Per kolom: het verhaal als scriptkaart, de scènes als storyboardrijen (gekoppeld aan de 2e verdieping), en de kaarten voor structuur, foto's, productie en plus/min."},{"id":"ngkv3bsbjf","cat":"colcard","kind":"colcard","x":-1150,"y":-717,"rot":0,"w":560,"h":270,"color":"#B8332A","label":"","path":[],"cw":560,"title":"Samenvatting","text":"1 · Kerst-editie — De bestaande film met een winterslot: het warmste, goedkoopste en veiligste pad — zonder humor.\n\n2 · Goed bedoeld — Drie vignetten van goede bedoelingen die praktisch worden; bewezen grappig, wel een remake.\n\n3A · Aan tafel — De klaptafel onder het viaduct die aanschuift bij de gigantische straattafel — één beeld dat blijft hangen.\n\n3B · De kerststal — Het Leger dat zijn eigen beelden aan de kant zet om met de mensen in de stal te eten. Baby Jezus blijft.\n\n3C · Het koor — Het koor bouwt zijn podium om tot eettafel: zingen tot je ziet dat soep beter werkt."},{"id":"f9nwkpabjf","cat":"colcard","kind":"colcard","x":-520,"y":-733,"rot":0,"w":620,"h":334,"color":"#6DBBAF","label":"","path":[],"cw":620,"title":"Vergelijking","text":"Humor: 1) geen · 2) sterk, bewezen · 3A) sterk, droog · 3B) zacht, zelfspot · 3C) sterk, zelfspot\nWarmte / samen: 1) sterk: de tafel spiegelt · 2) in het gebit en het slot · 3A) sterk: de straattafel · 3B) sterk: eten in de stal · 3C) sterk: podium wordt tafel\n\"Kerst is…\": 1) samen eten · 2) warm · samen eten · omkijken · 3A) samen eten · niet alleen · 3B) omkijken · er is plaats · 3C) samen eten · er voor elkaar zijn\nNaar \"geef aan de collectant\": 1) munt wordt bord · 2) de tandeloze collectant · 3A) munt wordt bord · 3B) doen wat we geloven · 3C) de tubaspeler met de bus\nFoto + opvolging: 1) twee tafels → één tafel · 2) gitaarvuur → de jas · 3A) klaptafel → straattafel · 3B) os in de armen → tafel in de stal · 3C) tafel onder het viaduct → leeg podium\n2–3 jaar: 1) ja · 2) ja, als reeks · 3A) ja, als reeks · 3B) ja, elk jaar een stal · 3C) ja, elk jaar een lied\nNieuw / rechten: 1) eigen film · 2) remake, rechten regelen · 3A) nieuw · 3B) nieuw · 3C) nieuw\nOmvang: 1) 1 draaidag, cast terug · 2) 2 dagen, 3 locaties · 3A) 1–2 dagen, viaduct + straat, grote figuratie · 3B) 1 avond, 1 plein, levensgrote stal (art) · 3C) 1 avond, 1 locatie, echt koor + figuratie"},{"id":"jp9utjhbjf","cat":"file","kind":"file","x":180,"y":-775,"rot":0,"w":300,"h":250,"color":"#5B6472","label":"","path":[],"fileId":"p10rr5dbjd","name":"Kerst is — conceptvoorstel.pdf","size":429965,"mime":"application/pdf","imgId":"9snbgswbjd"},{"id":"yng71ttbjf","cat":"file","kind":"file","x":520,"y":-860,"rot":0,"w":300,"h":64,"color":"#5B6472","label":"","path":[],"fileId":"eof0ivgbje","name":"LdH — Opeens is alles anders (Pink Revision 2).pdf","size":454197,"mime":"application/pdf","imgId":null},{"id":"v8ujy9cbjf","cat":"note","kind":"note","x":520,"y":-730,"rot":0,"w":300,"h":150,"color":"#A98BE0","label":"","path":[],"text":"BESTAAND SCRIPT\nOptie 1 hergebruikt scène 1–18 van \"Opeens is alles anders\". De split screen (gezond / ongeluk) loopt door tot kerst."},{"id":"02ticq8bjf","cat":"text","kind":"text","x":-1150,"y":-560,"rot":0,"w":545.1999999999999,"h":28,"color":"#6FA3E8","label":"","path":[],"fontSize":20,"bold":true,"italic":false,"text":"OPTIE 1 · OPEENS IS ALLES ANDERS — KERST-EDITIE"},{"id":"75xmx3cbjf","cat":"text","kind":"text","x":-1150,"y":-526,"rot":0,"w":399.61999999999995,"h":18.2,"color":"#6B675F","label":"","path":[],"fontSize":13,"bold":false,"italic":false,"text":"Remake van de bestaande film met een nieuw winterslot"},{"id":"e2naw99bjf","cat":"script","kind":"script","x":-1150,"y":180,"rot":0,"w":560,"h":1341.75,"color":"#5B6472","label":"","path":[],"mode":"film","title":"Optie 1 — Opeens is alles anders — kerst-editie","text":"Eén vrouw, twee levens. Dara's split screen loopt door tot kerst: links een gewone kerst thuis, rechts een kerstdiner in de buurthuiskamer van het Leger des Heils. Voor het eerst laten de twee helften hetzelfde zien: samen eten.\n\nHERGEBRUIK — scène 1 t/m 18 van de bestaande film blijven staan: bloemenwinkel, het telefoontje, de bakfiets, het kruispunt, de smash cut, en de split screen (ziekenhuis / collega met bloemen, rolstoel / vriend tilt haar op, UWV / trouwfoto's, bordje CLOSED / OPEN, huurachterstand / kaartje BEDANKT, achterbank / slaapkamer).\n\nNIEUW — de tijd verstrijkt in de split screen: het licht wordt winters, jassen gaan aan, de etalage vult zich met amaryllis en hulst (geen boom). De seizoenswissel is de motor naar kerst en verklaart waarom het nieuwe materiaal er anders uitziet.\n\n19 · EXT. BLOEMENWINKEL — WINTER, BLAUW UUR (links). Dara sluit de winkel, haar vriend wacht met tassen. Ze neemt de laatste bos amaryllis mee naar huis.\n\n20 · EXT. BLOEMENWINKEL (rechts). De dakloze Dara loopt langs met de flessen, blijft staan in het licht van de etalage. De blik: ken ik jou ergens van?\n\n21 · INT. DARA THUIS — KERSTAVOND (links). Tafel, vriend, ouders. De amaryllis in een vaas. Een schaal gaat rond, een glas wordt geheven.\n\n22 · INT. BUURTHUISKAMER LEGER DES HEILS (rechts). Lange tafel, damp, dertig mensen. Een vrijwilliger in uniform schept op. Dara krijgt een bord; de vrouw naast haar schuift het zout aan. DEZELFDE handelingen als links: bord, glas, lachen. De split screen contrasteert niet meer — hij spiegelt.\n\n23 · DE SPLIT VERDWIJNT. Het beeld wordt één: de lange tafel in de buurthuiskamer, Dara midden tussen de mensen.\n\n24 · EXT. VOORDEUR — AVOND (hybride eindshot). De gezonde Dara doet open voor een collectant. Munt in de bus. Cut: het bord dat rechts vóór de andere Dara wordt neergezet.\n\nKAART · KERST IS SAMEN ETEN. GEEF AAN DE COLLECTANT. Schild Leger des Heils.\n\nSTRUCTUUR 90\"\n• 0–10\" bloemenwinkel en het telefoontje\n• 10–20\" bakfiets, kruispunt, smash cut\n• 20–58\" split screen, versneld, seizoenen verstrijken\n• 58–80\" kerst aan twee tafels, split wordt één\n• 80–90\" voordeur, collectant, kaart\n\nSTRUCTUUR 30\"\n• 0–5\" kruispunt, smash cut\n• 5–15\" drie split-beats: ziekenhuis / thuis, UWV / bordje, achterbank / slaapkamer\n• 15–24\" kerst aan twee tafels, één tafel\n• 24–30\" voordeur, collectant, kaart\n\nVARIANTEN\nVariant A (aanbevolen) — Kerst aan twee tafels, split screen spiegelt, wordt één tafel. Meeste \"samen\", minste nieuw draaiwerk.\nVariant B — De ontmoeting aan het raam: Dara komt na het kerstshoppen met haar vriend langs de buurthuiskamer, kijkt door het beslagen raam en ziet zichzelf aan tafel. Sterk beeld, maar stiller en één set-up meer (raam + interieur).\nVariant C — De gezonde Dara is vrijwilliger en schept op voor haar alter ego. Visueel prachtig, maar de boodschap verschuift van \"het Leger is er\" naar \"de gelukkige helpt\" en de metafoor wordt letterlijk verwarrend. Niet aanbevolen.","textR":"","fontSize":12.5},{"id":"krrbkopbjf","cat":"text","kind":"text","x":-1150,"y":886,"rot":0,"w":200,"h":16.799999999999997,"color":"#B8332A","label":"","path":[],"fontSize":12,"bold":true,"italic":false,"text":"SCÈNES (storyboard)"},{"id":"bqpomcvbjf","cat":"sbrow","kind":"sbrow","x":-1150,"y":976,"rot":0,"w":560,"h":120,"color":"#6FA3E8","label":"","path":[],"title":"O1 · 19–20 Etalage winter","desc":"EXT. BLOEMENWINKEL — WINTER, BLAUW UUR\nLinks: Dara sluit de winkel, neemt de amaryllis mee. Rechts: de dakloze Dara blijft staan in het etalagelicht. Ken ik jou?","imgId":null,"sceneId":"zkk1ut1bje"},{"id":"yvvpefkbjf","cat":"sbrow","kind":"sbrow","x":-1150,"y":1110,"rot":0,"w":560,"h":120,"color":"#6FA3E8","label":"","path":[],"title":"O1 · 21 Kerst thuis","desc":"INT. DARA THUIS — KERSTAVOND\nTafel met vriend en ouders. Amaryllis in de vaas. Schaal gaat rond, glas geheven.","imgId":null,"sceneId":"dmzvhswbje"},{"id":"l4qq8vobjf","cat":"sbrow","kind":"sbrow","x":-1150,"y":1244,"rot":0,"w":560,"h":120,"color":"#6FA3E8","label":"","path":[],"title":"O1 · 22–23 Buurthuiskamer","desc":"INT. BUURTHUISKAMER LEGER DES HEILS — KERSTAVOND\nLange tafel, vrijwilliger in uniform schept op, Dara krijgt een bord. Spiegelt links. Split verdwijnt: één tafel.","imgId":null,"sceneId":"9xy6zv8bje"},{"id":"56v87hdbjf","cat":"sbrow","kind":"sbrow","x":-1150,"y":1378,"rot":0,"w":560,"h":120,"color":"#6FA3E8","label":"","path":[],"title":"O1 · 24 Voordeur","desc":"EXT. VOORDEUR — AVOND\nDara doet open voor de collectant. Munt in de bus. Cut naar het bord.","imgId":null,"sceneId":"qh1uf7gbje"},{"id":"67b7qt8bjf","cat":"colcard","kind":"colcard","x":-1150,"y":1533,"rot":0,"w":560,"h":110,"color":"#6FA3E8","label":"","path":[],"cw":560,"title":"Hybride eindshot — de collectant","text":"Dara (gezond) doet zelf de deur open voor de collectant. De munt in de bus wordt via de cut het bord voor de andere Dara — geven en krijgen in één beweging."},{"id":"1mhm3j6bjf","cat":"colcard","kind":"colcard","x":-1150,"y":1671,"rot":0,"w":560,"h":126,"color":"#E2A93B","label":"","path":[],"cw":560,"title":"Campagnefoto's","text":"• HERO · split-screen foto: twee Dara's, twee tafels, één horizon. Links thuis, rechts buurthuiskamer. Eén actrice, composite.\n• OPVOLGINGSFOTO · één tafel, de twee Dara's naast elkaar. Het reizende object: de bos amaryllis uit de winkel staat nu op de tafel van het Leger.\n• DEUR · Dara met de collectant op de stoep, warm licht uit de gang."},{"id":"5c11w9xbjf","cat":"colcard","kind":"colcard","x":-1150,"y":1841,"rot":0,"w":560,"h":142,"color":"#3E9B6E","label":"","path":[],"cw":560,"title":"Productie","text":"• 1 nieuwe draaidag: buurthuiskamer (kerstdiner, 25–30 figuranten), voordeur, etalage bij blauw uur\n• Actrice + vriend terug; continuïteit haar en look; grade matchen op de bestaande film\n• Winter faken: adem, jassen, natte straat, etalageverlichting\n• Check: muzieklicentie en cast-buy-out voor tv en 2–3 jaar; nieuwe eindkaart en mix\nKosten: € · 1 draaidag, kleine cast, één grote figuratiescène"},{"id":"8atlevtbjf","cat":"colcard","kind":"colcard","x":-1150,"y":2003,"rot":0,"w":560,"h":110,"color":"#3E9B6E","label":"","path":[],"cw":560,"title":"Plus","text":"• Bewezen film, laagste kosten en laagste risico voor 21 oktober\n• Split screen maakt 90\" en 30\" vanzelf uit hetzelfde materiaal\n• \"Wij zijn er ook als het anders loopt\" wordt zonder breuk een kerstboodschap\n• Split-screen foto is een sterk, eigen campagnebeeld"},{"id":"8raiaogbjf","cat":"colcard","kind":"colcard","x":-1150,"y":2133,"rot":0,"w":560,"h":110,"color":"#E58A6F","label":"","path":[],"cw":560,"title":"Min","text":"• Geen humor; het begin (ongeluk, ziekenhuis) is zwaar voor kersttijd\n• Afhankelijk van beschikbaarheid en look van de cast\n• Voelt het voor de opdrachtgever als nieuw? Het is een remake\n• Split screen vraagt aandacht van de 40+ kijker; de 30\" is krap"},{"id":"lciegvxbjf","cat":"text","kind":"text","x":-520,"y":-560,"rot":0,"w":255.2,"h":28,"color":"#E1B46A","label":"","path":[],"fontSize":20,"bold":true,"italic":false,"text":"OPTIE 2 · GOED BEDOELD"},{"id":"gl7wqttbjf","cat":"text","kind":"text","x":-520,"y":-526,"rot":0,"w":603.1999999999999,"h":18.2,"color":"#6B675F","label":"","path":[],"fontSize":13,"bold":false,"italic":false,"text":"Nederlandse remake van de Zwitserse Heilsarmee-vignetten, verlengd met een derde"},{"id":"tcn4ypjbjf","cat":"script","kind":"script","x":-520,"y":36,"rot":0,"w":560,"h":1079.25,"color":"#5B6472","label":"","path":[],"mode":"film","title":"Optie 2 — Goed bedoeld","text":"Het Leger des Heils wil helpen. Eerst op de manier van het Leger — met een lied, een uniform, een gebaar. Dan op de manier die werkt.\n\nVIGNET 1 · DE GITAAR. Onder een viaduct rilt HENK (60) in zijn slaapzak. Heilssoldate ANS (55) knielt met een gitaar en zet \"Stille nacht\" in, vol overgave. Henk rilt harder. Ans kijkt naar de gitaar. Naar de olieton. Naar de gitaar. — De gitaar brandt. Twee paar handen boven het vuur. Ans neuriet het lied nog even. \"Kerst is warm.\"\n\nVIGNET 2 · HET GEBIT. Kerstdiner in de buurthuiskamer. Heilssoldaat BERT (65) geniet van zijn rollade. Naast hem RIA (70), dakloos, mond dicht, kijkt opzij. Bert kauwt, kijkt, snapt het. Kijkt om zich heen. Haalt discreet zijn kunstgebit uit en legt het op haar servet. Ria lacht — mét tanden. Bert schept puree op. \"Kerst is samen eten.\"\n\nVIGNET 3 · DE JAS (nieuw, voor de 90\"). Bushokje, ijzige wind. Ans stapt uit het busje met een stapel flyers KERST IS NIET ALLEEN ZIJN en drukt er een in de handen van een bibberende jongen, JOEY (19). Hij leest. Hij bibbert. Ans doet haar uniformjas uit en hangt hem om Joey heen. Zij staat in haar witte blouse in de wind, hij zit in een jas met schild. Hij salueert aarzelend. Zij ook. \"Kerst is omkijken naar de ander.\"\n\nSLOT · INT. BUURTHUISKAMER. Alle drie de duo's aan één lange tafel: Henk met een kop soep, Ria die lacht met tanden, Joey in de te grote jas. Ans en Bert schuiven aan.\n\nHYBRIDE EINDSHOT · EXT. VOORDEUR — AVOND. Een collectant belt aan. Een vrouw doet open. De collectant is Bert: hij lacht breed — zonder tanden. Munt in de bus. \"Fijne kerst.\"\n\nKAART · GOED BEDOELD. GOED GEDAAN. GEEF AAN DE COLLECTANT. Schild Leger des Heils.\n\nSTRUCTUUR 90\"\n• 0–25\" de gitaar\n• 25–50\" het gebit\n• 50–72\" de jas\n• 72–82\" allemaal aan één tafel\n• 82–90\" voordeur, tandeloze collectant, kaart\n\nSTRUCTUUR 30\"\n• 0–20\" het gebit (meest verrassend, én de tafel = kerst)\n• 20–30\" voordeur, tandeloze collectant, kaart\n\nVARIANTEN\nTrouw aan het origineel — Alleen gitaar en gebit, één-op-één vertaald; slot met de tandeloze collectant. Kortste weg, hoogste \"al gezien\"-risico.\nFormule (aanbevolen binnen optie 2) — Gitaar + gebit + de jas als bewijs dat de formule van ons is: elk jaar een nieuw vignet, dezelfde Ans en Bert. Zo gaat het 2–3 jaar mee en is de 30\" elk jaar een ander vignet.","textR":"","fontSize":12.5},{"id":"lfyd8hpbjf","cat":"text","kind":"text","x":-520,"y":598,"rot":0,"w":200,"h":16.799999999999997,"color":"#B8332A","label":"","path":[],"fontSize":12,"bold":true,"italic":false,"text":"SCÈNES (storyboard)"},{"id":"enawzzsbjf","cat":"sbrow","kind":"sbrow","x":-520,"y":688,"rot":0,"w":560,"h":120,"color":"#E1B46A","label":"","path":[],"title":"O2 · V1 Viaduct — de gitaar","desc":"EXT. VIADUCT — NACHT\nHenk rilt, Ans speelt Stille nacht, kijkt naar de olieton. De gitaar brandt; handen boven het vuur.","imgId":null,"sceneId":"ft4itcqbje"},{"id":"zgedyjbbjf","cat":"sbrow","kind":"sbrow","x":-520,"y":822,"rot":0,"w":560,"h":120,"color":"#E1B46A","label":"","path":[],"title":"O2 · V2 Buurthuiskamer — het gebit","desc":"INT. BUURTHUISKAMER — KERSTDINER\nBert geniet van de rollade, Ria kijkt opzij. Het gebit op het servet. Ria lacht met tanden.","imgId":null,"sceneId":"aqw9my9bje"},{"id":"a2ig9d6bjf","cat":"sbrow","kind":"sbrow","x":-520,"y":956,"rot":0,"w":560,"h":120,"color":"#E1B46A","label":"","path":[],"title":"O2 · V3 Bushalte — de jas","desc":"EXT. BUSHALTE — SCHEMER, WIND\nFlyers \"Kerst is niet alleen zijn\". Ans hangt haar uniformjas om Joey. Salueren.","imgId":null,"sceneId":"y0iqh6dbje"},{"id":"wv7cl4zbjf","cat":"sbrow","kind":"sbrow","x":-520,"y":1090,"rot":0,"w":560,"h":120,"color":"#E1B46A","label":"","path":[],"title":"O2 · Slot tafel + voordeur","desc":"INT. BUURTHUISKAMER / EXT. VOORDEUR — AVOND\nAlle duo's aan één tafel. Bert als collectant, tandeloze lach, munt in de bus.","imgId":null,"sceneId":"78kllicbje"},{"id":"923y9q0bjf","cat":"colcard","kind":"colcard","x":-520,"y":1245,"rot":0,"w":560,"h":110,"color":"#6FA3E8","label":"","path":[],"cw":560,"title":"Hybride eindshot — de collectant","text":"De collectant aan de deur is Bert, zonder gebit. De glimlach is de payoff van vignet 2 en maakt van het verplichte eindshot een grap met hart."},{"id":"81rx33wbjf","cat":"colcard","kind":"colcard","x":-520,"y":1383,"rot":0,"w":560,"h":126,"color":"#E2A93B","label":"","path":[],"cw":560,"title":"Campagnefoto's","text":"• HERO · de brandende gitaar onder het viaduct, twee paar handen erboven, Ans in uniform en Henk in slaapzak, beiden verlicht door het vuur.\n• OPVOLGINGSFOTO · Ans in haar blouse, Joey in haar uniformjas, samen aan de lange tafel. Het reizende object: de jas met het schild.\n• DEUR · Bert met collectebus en tandeloze lach op de stoep."},{"id":"keyca8wbjf","cat":"colcard","kind":"colcard","x":-520,"y":1545,"rot":0,"w":560,"h":142,"color":"#3E9B6E","label":"","path":[],"cw":560,"title":"Productie","text":"• 3 locaties: viaduct, buurthuiskamer, bushalte (kan één nacht + één dag)\n• 2 draaidagen; 6 acteurs, casting op comedy-timing is alles\n• Special: brandende gitaar (brandveiligheid, 2 gitaren), kunstgebit-prop (2 sets)\n• Rechten: toestemming of creditering van de Zwitserse Heilsarmee regelen via LdH; anders \"geïnspireerd door\" met eigen vignetten\nKosten: €€ · 2 draaidagen, 3 locaties, specials (vuur, gebit)"},{"id":"rcw8j6qbjf","cat":"colcard","kind":"colcard","x":-520,"y":1699,"rot":0,"w":560,"h":110,"color":"#3E9B6E","label":"","path":[],"cw":560,"title":"Plus","text":"• Bewezen humor; de zelfspot is precies wat de opdrachtgever aanwijst\n• Vignet-formule: elk jaar uitbreidbaar met dezelfde personages\n• De 30\" is één vignet en werkt online op zichzelf\n• Sterke, grappige stills"},{"id":"tsfh3nlbjf","cat":"colcard","kind":"colcard","x":-520,"y":1829,"rot":0,"w":560,"h":110,"color":"#E58A6F","label":"","path":[],"cw":560,"title":"Min","text":"• Remake: rechten en het \"al gezien\"-gevoel bij vakpubliek\n• Het gebit kan voor een deel van de 40+ kijkers te plat zijn — testen\n• Warmte en \"samen\" zitten vooral in vignet 2 en het slot\n• Drie set-ups plus specials: duurder dan het lijkt"},{"id":"wojg5rnn2p","cat":"text","kind":"text","x":110,"y":-560,"rot":0,"w":231.99999999999997,"h":32,"color":"#E58A6F","label":"","path":[],"fontSize":20,"bold":true,"italic":false,"text":"OPTIE 3A · AAN TAFEL"},{"id":"ilkqgbfn2p","cat":"text","kind":"text","x":110,"y":-526,"rot":0,"w":361.91999999999996,"h":20.8,"color":"#6B675F","label":"","path":[],"fontSize":13,"bold":false,"italic":false,"text":"Origineel — een komische situatie die warm landt"},{"id":"h3bau71n2p","cat":"script","kind":"script","x":110,"y":-180,"rot":0,"w":560,"h":612,"color":"#5B6472","label":"","path":[],"mode":"film","title":"Optie 3A — Aan tafel","text":"Heilssoldate Ineke wil dat iedereen met kerst aan tafel zit. Dus brengt ze een klaptafel naar de man onder het viaduct. Pas als het kleed wegwaait snapt ze het: niet een tafel naar hem — hem naar dé tafel.\n\nIN VIJF BEATS\n1. Uit het busje van het Leger: een klaptafel, een stoel, een wit kleed.\n2. Kaars, bord, rollade, servet in een punt, een kerstster. Hij gaat zitten — uit beleefdheid.\n3. Vrachtwagen dendert over, kaars uit. Hij eet alleen. Zij kijkt. Dit klopt niet.\n4. Het kleed waait weg. Ze klapt de stoel in. \"Kom.\"\n5. Om de hoek, midden op straat: één gigantische tafel, tientallen mensen, lichtjes erboven, dampende pannen. De klaptafel schuift aan het einde aan — hij past precies. Collectant aan de deur.\n\nKAART: KERST IS SAMEN ETEN. GEEF AAN DE COLLECTANT.\n\n30\": Tafel · kaars uit · kleed waait · de straattafel · deur.\n\nFOTO'S: Hero: de gedekte kersttafel onder het viaduct. Opvolging: de klaptafel aangeschoven aan de gigantische tafel op straat, lichtjes erboven.\n\nNOOT: Geïnspireerd op wat de soepfiets in Ede met kerst doet: een enorme tafel op straat. Grappig én warm; de straattafel is meteen de campagnefoto. Kan echt onder een viaduct of in de studio (\"alles is nep\").","textR":"","fontSize":12.5},{"id":"speb6oen2p","cat":"text","kind":"text","x":110,"y":166,"rot":0,"w":200,"h":19.200000000000003,"color":"#B8332A","label":"","path":[],"fontSize":12,"bold":true,"italic":false,"text":"SCÈNES (storyboard)"},{"id":"htneoddn2p","cat":"sbrow","kind":"sbrow","x":110,"y":256,"rot":0,"w":560,"h":120,"color":"#E58A6F","label":"","path":[],"title":"O3A · 1–4 Viaduct — de klaptafel","desc":"EXT. VIADUCT — LATE MIDDAG, BLAUW UUR\nFrans op zijn matras. Ineke dekt een kersttafel uit het busje: kleed, kaars, bord, rollade, kerstster. Kaars uit. Kleed waait. \"Kom.\"","imgId":null,"sceneId":"9u8rditn2p"},{"id":"ebiipkjn2p","cat":"sbrow","kind":"sbrow","x":110,"y":390,"rot":0,"w":560,"h":120,"color":"#E58A6F","label":"","path":[],"title":"O3A · 5 Straat — de gigantische tafel","desc":"EXT. STRAAT — AVOND\nEén lange tafel over de hele straat, tientallen mensen, lichtjes erboven, dampende pannen. De klaptafel past precies aan het einde.","imgId":null,"sceneId":"7weu7qjn2p"},{"id":"vu7iu9mn2p","cat":"sbrow","kind":"sbrow","x":110,"y":524,"rot":0,"w":560,"h":120,"color":"#E58A6F","label":"","path":[],"title":"O3A · 6 Voordeur","desc":"EXT. VOORDEUR — AVOND\nCollectant belt aan bij een gezin. Munt in de bus. Cut naar het bord.","imgId":null,"sceneId":"jk826d8n2p"},{"id":"nluwor8n2p","cat":"colcard","kind":"colcard","x":110,"y":679,"rot":0,"w":560,"h":110,"color":"#E2A93B","label":"","path":[],"cw":560,"title":"Campagnefoto's","text":"Hero: de gedekte kersttafel onder het viaduct. Opvolging: de klaptafel aangeschoven aan de gigantische tafel op straat, lichtjes erboven."},{"id":"545d935n2p","cat":"colcard","kind":"colcard","x":110,"y":809,"rot":0,"w":560,"h":110,"color":"#3E9B6E","label":"","path":[],"cw":560,"title":"Noot","text":"Geïnspireerd op wat de soepfiets in Ede met kerst doet: een enorme tafel op straat. Grappig én warm; de straattafel is meteen de campagnefoto. Kan echt onder een viaduct of in de studio (\"alles is nep\")."},{"id":"5wzegfin2p","cat":"text","kind":"text","x":740,"y":-560,"rot":0,"w":266.79999999999995,"h":32,"color":"#B8332A","label":"","path":[],"fontSize":20,"bold":true,"italic":false,"text":"OPTIE 3B · DE KERSTSTAL"},{"id":"10mkjnjn2p","cat":"text","kind":"text","x":740,"y":-526,"rot":0,"w":422.23999999999995,"h":20.8,"color":"#6B675F","label":"","path":[],"fontSize":13,"bold":false,"italic":false,"text":"Origineel — vanuit het Leger zelf: \"Doen wat we geloven\""},{"id":"4huyu2nn2p","cat":"script","kind":"script","x":740,"y":-117,"rot":0,"w":560,"h":738,"color":"#5B6472","label":"","path":[],"mode":"film","title":"Optie 3B — De kerststal","text":"Heilssoldaat Henk bouwt op het plein een levensgrote kerststal, tot in de puntjes. Als hij het kindje in de kribbe legt, ziet hij de mannen die achter het hek staan te kijken. Dan zet hij de beelden ernaast. En dekt de tafel in de stal.\n\nIN VIJF BEATS\n1. Plein voor het Legergebouw, schemer. Een levensgrote stal: os, ezel, herders, drie koningen, stro. Henk (60) legt de laatste hand: de ster recht, stof van de herder. Perfect moet het.\n2. Achter het hek: een man met slaapzak. Dan twee, dan drie. Ze kijken naar het warme licht. Henk ziet ze niet — hij is met Jozef bezig.\n3. Het kindje. Henk kijkt naar de kribbe. Geen plaats in de herberg. Legt het neer. Kijkt op — en ziet de mannen.\n4. Henk tilt de os op en zet hem buiten de stal. Dan de ezel. De koningen. Jozef en Maria, netjes op een rij ernaast. Het kindje blijft. In de stal: een tafel, soep, brood. \"Kom.\"\n5. Henk en de mannen eten in de stal, op het stro, onder de ster. De beelden staan ernaast toe te kijken. Collectant aan de deur.\n\nKAART: ER IS PLAATS. GEEF AAN DE COLLECTANT.\n\n30\": De stal · het kindje · de beelden ernaast · eten in de stal · deur.\n\nFOTO'S: Hero: Henk met de os in zijn armen, de mannen achter het hek. Opvolging: de beelden op een rij náást de stal, binnen de tafel vol mensen, het kindje in het midden.\n\nNOOT: De grap ligt bij het Leger zelf: het eigen ritueel wordt letterlijk aan de kant gezet voor de mens. Baby Jezus mag blijven. Eén locatie, één avond; de levensgrote stal is meteen de campagnefoto.\n\nVARIANT · De beste wensen — de samaritaan\nIedereen wenst de man fijne dagen en loopt door. De heilssoldate ook. Tien meter verder staat ze stil, loopt terug en pakt zijn tas. Geen kaarten, geen stapel — alleen die ene omkeer.","textR":"","fontSize":12.5},{"id":"51hj4pln2p","cat":"text","kind":"text","x":740,"y":292,"rot":0,"w":200,"h":19.200000000000003,"color":"#B8332A","label":"","path":[],"fontSize":12,"bold":true,"italic":false,"text":"SCÈNES (storyboard)"},{"id":"0131tyzn2p","cat":"sbrow","kind":"sbrow","x":740,"y":382,"rot":0,"w":560,"h":120,"color":"#B8332A","label":"","path":[],"title":"O3B · 1–3 Plein — de levensgrote stal","desc":"EXT. PLEIN VOOR HET LEGER — SCHEMER\nHenk perfectioneert de levensgrote stal. Achter het hek de mannen met slaapzakken. Het kindje in de kribbe — Henk kijkt op en ziet ze.","imgId":null,"sceneId":"c3zagp3n2p"},{"id":"aeypz8un2p","cat":"sbrow","kind":"sbrow","x":740,"y":516,"rot":0,"w":560,"h":120,"color":"#B8332A","label":"","path":[],"title":"O3B · 4–5 De stal — aan tafel","desc":"EXT. KERSTSTAL — AVOND\nDe beelden ernaast op een rij, het kindje blijft. Tafel met soep en brood in de stal; Henk en de mannen op het stro, onder de ster.","imgId":null,"sceneId":"p4gzkv1n2p"},{"id":"sarjnrvn2p","cat":"sbrow","kind":"sbrow","x":740,"y":650,"rot":0,"w":560,"h":120,"color":"#B8332A","label":"","path":[],"title":"O3B · 6 Voordeur","desc":"EXT. VOORDEUR — AVOND\nCollectant belt aan. Munt in de bus.","imgId":null,"sceneId":"driflw7n2p"},{"id":"9ic9k5cn2p","cat":"colcard","kind":"colcard","x":740,"y":805,"rot":0,"w":560,"h":110,"color":"#E2A93B","label":"","path":[],"cw":560,"title":"Campagnefoto's","text":"Hero: Henk met de os in zijn armen, de mannen achter het hek. Opvolging: de beelden op een rij náást de stal, binnen de tafel vol mensen, het kindje in het midden."},{"id":"7rkh79kn2p","cat":"colcard","kind":"colcard","x":740,"y":935,"rot":0,"w":560,"h":110,"color":"#3E9B6E","label":"","path":[],"cw":560,"title":"Noot","text":"De grap ligt bij het Leger zelf: het eigen ritueel wordt letterlijk aan de kant gezet voor de mens. Baby Jezus mag blijven. Eén locatie, één avond; de levensgrote stal is meteen de campagnefoto."},{"id":"9jrhqd2n2p","cat":"colcard","kind":"colcard","x":740,"y":1065,"rot":0,"w":560,"h":110,"color":"#E58A6F","label":"","path":[],"cw":560,"title":"Variant · De beste wensen — de samaritaan","text":"Iedereen wenst de man fijne dagen en loopt door. De heilssoldate ook. Tien meter verder staat ze stil, loopt terug en pakt zijn tas. Geen kaarten, geen stapel — alleen die ene omkeer."},{"id":"76ra387n2p","cat":"text","kind":"text","x":1370,"y":-560,"rot":0,"w":220.39999999999998,"h":32,"color":"#6DBBAF","label":"","path":[],"fontSize":20,"bold":true,"italic":false,"text":"OPTIE 3C · HET KOOR"},{"id":"s25wbtpn2p","cat":"text","kind":"text","x":1370,"y":-526,"rot":0,"w":354.38,"h":20.8,"color":"#6B675F","label":"","path":[],"fontSize":13,"bold":false,"italic":false,"text":"Origineel — het Leger zingt, tot het beter weet"},{"id":"n9xrwg7n2p","cat":"script","kind":"script","x":1370,"y":-144,"rot":0,"w":560,"h":684,"color":"#5B6472","label":"","path":[],"mode":"film","title":"Optie 3C — Het koor","text":"Kerstavond. Het koor van het Leger staat op een stellage van bankjes, stoelen en strobalen en zingt prachtig voor de mensen onder het viaduct. Ze hebben het nog steeds koud. Dan bouwt het koor de stellage om — tot één lange, goed gevulde eettafel.\n\nIN VIJF BEATS\n1. Onder het viaduct, blauw uur. Een stellage van bankjes, stoelen en strobalen; daarop twaalf uniformen en koperblazers. \"Stille nacht\", meerstemmig, prachtig.\n2. Het publiek: een handvol mensen met slaapzakken. Ze knikken beleefd. Ze rillen. Een tubanoot, een windvlaag.\n3. Tweede couplet. De dirigente kijkt naar de mensen, naar de adem in de lucht. Haar handen zakken. \"Jongens.\"\n4. Het koor breekt de stellage af en bouwt hem om: bankjes worden banken, planken worden tafel, strobalen worden stoelen. Gamellen uit het busje, soep, brood. De instrumenten in de hoek.\n5. Eindbeeld: één lange tafel onder het viaduct, koor en gasten door elkaar, lichtjes erboven, damp. Iemand neuriet. Collectant aan de deur: de tubaspeler met bus.\n\nKAART: EERST SOEP. DAN ZINGEN. GEEF AAN DE COLLECTANT.\n\n30\": Koor op de stellage · rillen · \"Jongens.\" · ombouwen · tafel onder de lichtjes · deur.\n\nFOTO'S: Hero: de lange tafel onder het viaduct, koor en gasten door elkaar, lichtjes erboven, de instrumenten in de hoek. Opvolging: het lege podium van strobalen, ernaast de instrumenten.\n\nNOOT: Geïnspireerd op de straattafel van de soepfiets in Ede. Zelfspot op het meest herkenbare beeld van het Leger: het koor. Het zingen blijft, het komt alleen op de tweede plaats. Eén avond, één locatie, een echt Legerkoor als cast.","textR":"","fontSize":12.5},{"id":"hjfisz4n2p","cat":"text","kind":"text","x":1370,"y":238,"rot":0,"w":200,"h":19.200000000000003,"color":"#B8332A","label":"","path":[],"fontSize":12,"bold":true,"italic":false,"text":"SCÈNES (storyboard)"},{"id":"mwokcwhn2p","cat":"sbrow","kind":"sbrow","x":1370,"y":328,"rot":0,"w":560,"h":120,"color":"#6DBBAF","label":"","path":[],"title":"O3C · 1–3 Viaduct — het koor op de stellage","desc":"EXT. VIADUCT — BLAUW UUR\nStellage van bankjes, stoelen en strobalen. Twaalf uniformen zingen Stille nacht. Het publiek rilt. De dirigente laat haar handen zakken: \"Jongens.\"","imgId":null,"sceneId":"r1tmh9fn2p"},{"id":"vzd10xyn2p","cat":"sbrow","kind":"sbrow","x":1370,"y":462,"rot":0,"w":560,"h":120,"color":"#6DBBAF","label":"","path":[],"title":"O3C · 4–5 Viaduct — de tafel","desc":"EXT. VIADUCT — AVOND\nDe stellage wordt een lange tafel. Soep, brood, lichtjes erboven. De instrumenten in de hoek. Koor en gasten door elkaar.","imgId":null,"sceneId":"yf872x1n2p"},{"id":"jfb0ydnn2p","cat":"sbrow","kind":"sbrow","x":1370,"y":596,"rot":0,"w":560,"h":120,"color":"#6DBBAF","label":"","path":[],"title":"O3C · 6 Voordeur","desc":"EXT. VOORDEUR — AVOND\nDe tubaspeler als collectant. Munt in de bus. \"Fijne kerst.\"","imgId":null,"sceneId":"zx3tj1yn2p"},{"id":"r4gj1tln2p","cat":"colcard","kind":"colcard","x":1370,"y":751,"rot":0,"w":560,"h":110,"color":"#E2A93B","label":"","path":[],"cw":560,"title":"Campagnefoto's","text":"Hero: de lange tafel onder het viaduct, koor en gasten door elkaar, lichtjes erboven, de instrumenten in de hoek. Opvolging: het lege podium van strobalen, ernaast de instrumenten."},{"id":"244uxydn2p","cat":"colcard","kind":"colcard","x":1370,"y":881,"rot":0,"w":560,"h":110,"color":"#3E9B6E","label":"","path":[],"cw":560,"title":"Noot","text":"Geïnspireerd op de straattafel van de soepfiets in Ede. Zelfspot op het meest herkenbare beeld van het Leger: het koor. Het zingen blijft, het komt alleen op de tweede plaats. Eén avond, één locatie, een echt Legerkoor als cast."}],"stills":[],"scene":"","sceneDesc":"","script":"","date":"","time":"","duration":60,"weather":"Any","sun":null,"shots":[]},"script":{"text":"","type":"film"},"exportPrefs":{"grid":true,"stills":true}},"assets":{"img":{"rj12zwpbjd":"data:image/jpeg;base64,","g7pqhi1bjd":"data:image/jpeg;base64,","9snbgswbjd":"data:image/jpeg;base64,","0v3b07fi4v":"data:image/jpeg;base64,","10n2txjis2":"data:image/jpeg;base64,","2a3axukab3":"data:image/jpeg;base64,","2hzq0wne2r":"data:image/jpeg;base64,","5e8gawcjko":"data:image/jpeg;base64,","672je96thh":"data:image/jpeg;base64,","6ieq34aooz":"data:image/jpeg;base64,","6lvp119klx":"data:image/jpeg;base64,","8a7q05zzxj":"data:image/jpeg;base64,","8orhh0zttz":"data:image/jpeg;base64,","ahe8ei9j41":"data:image/jpeg;base64,","d3g8cfqp0i":"data:image/jpeg;base64,","de0ffi3a05":"data:image/jpeg;base64,","dgzw2i8ko7":"data:image/jpeg;base64,","jbem4rpkci":"data:image/jpeg;base64,","ji7tx3j6is":"data:image/jpeg;base64,","l295m8592m":"data:image/jpeg;base64,","nao7zejshw":"data:image/jpeg;base64,","nfyodno4k1":"data:image/jpeg;base64,","nxql8vj0tu":"data:image/jpeg;base64,","oawidckjyu":"data:image/jpeg;base64,","qh9mn72k5q":"data:image/jpeg;base64,","s5q00e757c":"data:image/jpeg;base64,","sfgacu13za":"data:image/jpeg;base64,","tbuescc0rq":"data:image/jpeg;base64,","tne3txsxnq":"data:image/jpeg;base64,","uf7spb3ufk":"data:image/jpeg;base64,","uh035shjsn":"data:image/jpeg;base64,","w6rninzgoi":"data:image/jpeg;base64,","wt5vy5wkul":"data:image/jpeg;base64,","x0mk633j8s":"data:image/jpeg;base64,","xcbc94jb35":"data:image/jpeg;base64,"},"file":{}}}